# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# ---------------------------------------------------------------------------
# Create a project at https://console.neon.tech and copy the pooled connection
# string. Required by lib/db and by `pnpm run db:push`.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ---------------------------------------------------------------------------
# API server (artifacts/api-server)
# ---------------------------------------------------------------------------
PORT=5000

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-before-running-anything-real

# Browser origin allowed to call the API in development. In production the API
# serves the built frontend itself, so this is unset and CORS is not needed.
CORS_ORIGIN=http://localhost:5173

# Log verbosity: trace | debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Frontend (artifacts/trust-hub)
# ---------------------------------------------------------------------------
# Vite dev server port. Requests to /api are proxied to API_PROXY_TARGET, which
# keeps the browser on one origin so session cookies behave as in production.
# BASE_PATH defaults to "/" and only needs setting for sub-path deployments.
# VITE_PORT is read as PORT by Vite; leave unset unless 5173 is taken.
API_PROXY_TARGET=http://localhost:5000
